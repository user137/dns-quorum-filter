{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dnsqb-ui",
  "version": "0.1.0",
  "identifier": "com.dns-quorum-filter.ui",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DNS Quorum Filter",
        "width": 480,
        "height": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
