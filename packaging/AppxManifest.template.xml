<?xml version="1.0" encoding="utf-8"?>
<!--
  T-156 (Батч 3.8). {{VERSION}} / {{PUBLISHER}} are substituted by
  pack-msix.ps1 at pack time — never hand-edit a literal version/publisher
  in here, it would silently drift from what the binaries and the signing
  cert actually carry.

  Publisher identity is a placeholder for sideload (kickoff decision,
  2026-09-04): "CN=dns-quorum-filter", matched exactly by the signing
  cert's subject (see pack-msix.ps1 — one shared value, not two literals
  that happen to agree today). A future Microsoft Store submission replaces
  Name/Publisher with the values Partner Center assigns and re-signs with
  Microsoft's own certificate (the same model already decided for binary
  signing, T-102) — nothing else in this file needs to change for that.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity
    Name="dns-quorum-filter"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>DNS Quorum Filter</DisplayName>
    <PublisherDisplayName>DNS Quorum Filter</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!--
    T-287: the 37 interface languages (crates/dnsqb-service/ui/i18n), as the
    Store's supported language codes. The first entry is the package's
    default language. There is no resources.pri: the app picks its language
    at run time, so these entries only tell the Store which languages the
    app supports (and which listing languages Partner Center offers).
  -->
  <Resources>
    <Resource Language="en-US" />
    <Resource Language="uk-UA" />
    <Resource Language="ar-SA" />
    <Resource Language="bg-BG" />
    <Resource Language="cs-CZ" />
    <Resource Language="da-DK" />
    <Resource Language="de-DE" />
    <Resource Language="el-GR" />
    <Resource Language="es-ES" />
    <Resource Language="et-EE" />
    <Resource Language="fi-FI" />
    <Resource Language="fr-FR" />
    <Resource Language="he-IL" />
    <Resource Language="hi-IN" />
    <Resource Language="hr-HR" />
    <Resource Language="hu-HU" />
    <Resource Language="id-ID" />
    <Resource Language="it-IT" />
    <Resource Language="ja-JP" />
    <Resource Language="ko-KR" />
    <Resource Language="lt-LT" />
    <Resource Language="lv-LV" />
    <Resource Language="nb-NO" />
    <Resource Language="nl-NL" />
    <Resource Language="pl-PL" />
    <Resource Language="pt-BR" />
    <Resource Language="ro-RO" />
    <Resource Language="sk-SK" />
    <Resource Language="sl-SI" />
    <Resource Language="sr-Latn-RS" />
    <Resource Language="sv-SE" />
    <Resource Language="sw-KE" />
    <Resource Language="th-TH" />
    <Resource Language="tr-TR" />
    <Resource Language="ur-PK" />
    <Resource Language="vi-VN" />
    <Resource Language="zh-Hans-CN" />
  </Resources>

  <!--
    runFullTrust (T-156; full list T-287, packaging/STORE-LISTING.md): a
    packaged Win32 desktop app, not an AppContainer app. It needs: spawning
    its own sibling processes (watcher -> service/tray, by absolute path);
    certutil.exe for the user's CurrentUser\Root store (install/remove the
    local 127.0.0.1 leaf certificate, only after the user confirms);
    Windows Credential Manager (TLS key, encryption keys, MaxMind key);
    named pipes and files in its own data folder for the watchdog; reading
    two HKCU values (startup-task state, region); rundll32/explorer to open
    the settings page and Windows Settings; one PowerShell child for
    "Remove everything". No traffic interception: the browser is pointed at
    the local DoH address explicitly; the app is not a proxy.
  -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="App" Executable="dnsqb-watcher.exe" EntryPoint="Windows.FullTrustApplication">
      <!--
        The Start-menu tile launches dnsqb-watcher.exe, not dnsqb-service.exe
        or dnsqb-tray.exe directly — the watcher's idempotent launcher
        (watchdog::launcher::plan_launch, T-150) is what actually brings up
        the service and tray if they aren't already running, and does
        nothing if they are. One shortcut either starts everything or
        confirms everything is already running.
      -->
      <uap:VisualElements
        DisplayName="DNS Quorum Filter"
        Description="Local DNS filter for your browser"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="transparent" />
      <Extensions>
        <!--
          T-150's autostart design (SPEC.md §7): the Startup-entry target is
          dnsqb-watcher.exe, never dnsqb-service.exe directly — same
          idempotent-launcher reasoning as the tile above, just triggered at
          login instead of by a click. User-visible and user-toggleable in
          Settings > Apps > Startup, not a hidden registry Run key.
        -->
        <desktop:Extension Category="windows.startupTask" Executable="dnsqb-watcher.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="DnsqbWatcherStartup" Enabled="true" DisplayName="DNS Quorum Filter" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
